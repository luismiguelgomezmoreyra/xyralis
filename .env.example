# Variables de entorno para Sentinel-2
# Obtén tus credenciales en: https://register Copernicus.eu

# Usuario de Copernicus Open Access Hub
COPERNICUS_USER=tu_usuario_aqui

# Contraseña de Copernicus Open Access Hub
COPERNICUS_PASSWORD=tu_password_aqui

# Configuración de API (opcional, por defecto apunta a apihub.copernicus.eu)
COPERNICUS_API_URL=https://apihub.copernicus.eu/apihub
